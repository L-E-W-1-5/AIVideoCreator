<Window x:Class="AIVideoCreator.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIVideoCreator.WPF"
        mc:Ignorable="d"
        Title="AI Video Creator" 
        Height="750" 
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style TargetType="Button">

            <Setter Property="Background" Value="#343B4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            
        </Style>
        
    </Window.Resources>
    
    <Grid Background="#171923">

        <Grid.ColumnDefinitions>
            
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#20242f"
                Padding="20">

            <StackPanel>

                <TextBlock Text="AI Video Creator"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="white"
                           Margin="0,10,0,40"/>
                
                <TextBlock Text="MENU"
                           Foreground="#858B9B"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>
                
                <Button Content="Dashboard"
                        Click="DashboardButton_Click"
                        Margin="0,0,0,10"/>

                <Button Content="Projects"
                        Margin="0,0,0,10"/>

                <Button Content="Create Video"
                        Margin="0,0,0,10"/>

                <Button Content="Video Library"
                        Margin="0,0,0,10"/>
                
                <Button Content="Settings"
                        Margin="0,0,0,10"/>
                

            </StackPanel>

        </Border>

        <Grid Grid.Column="1"
              Margin="30">

            <StackPanel>

                <TextBlock Text="Dashboard"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Welcome to your AI Video Creator"
                           FontSize="14"
                           Foreground="#858B9B"
                           Margin="0,8,0,0"/>

                <ListBox ItemsSource="{Binding Projects}"/>

            </StackPanel>

        </Grid>

    </Grid>
    
</Window>
